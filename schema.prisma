generator client {
  provider             = "prisma-client-py"
  previewFeatures      = ["fullTextSearch"]
  interface            = "asyncio"
  recursive_type_depth = "5"
}

datasource db {
  provider = "mysql"
  url      = "mysql://2deru4m0qi7e2pf0ymx8:pscale_pw_BU8Vd8IcnZKRfQh0ltEZs2dq9uIcZJQ71Jx3YJEfG1E@us-east.connect.psdb.cloud/auction-market-prod?sslaccept=strict"
}

model User {
  id        Int      @id @default(autoincrement())
  phone     String?  @unique
  email     String?  @unique
  name      String
  password  String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tokens    Token[]
  Fav       Fav[]
}

model Token {
  id        Int      @id @default(autoincrement())
  payload   String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Item {
  id                  Int              @id @default(autoincrement())
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  caseNumber          String
  caseIndex           String
  itemNumber          String
  itemType            String
  initialPrice        String
  minPrice            String
  bidType             String
  saleDate            DateTime
  description         String           @db.MediumText
  itemLocation        String
  court               String
  caseApplyDate       DateTime
  auctionApplyDate    DateTime
  allocationApplyDate DateTime?
  requestPrice        String
  detailOfList        String           @default("") @db.MediumText
  areaOfBuilding      Float
  areaOfGround        Float
  appraisal           String           @db.MediumText
  status              Int              @default(0)
  lastestStatus       String           @default("")
  numOfPass           Int              @default(0)
  share               Boolean          @default(false)
  resultAuction       resultAuction[]
  leaseDetail         leaseDetail[]
  leasePeople         leasePeople[]
  Fav                 Fav[]
  realestateList      realestateList[]
  images              String           @default("")
  uniqueCode          String           @default("")
  pdfHex              String           @default("") @db.LongText
  visited             Int              @default(0)
  certification       certification[]
  Recommend           recommend[]
  adminComment        adminComment[]
}

model certification {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rank      String
  purpose   String   @default("")
  date      DateTime
  detail    String   @db.MediumText
  creditor  String   @default("")
  amount    String   @default("")
  owner     String
  type      String   @default("")
  title     String   @default("")
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    Int
}

model recommend {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    Int
}

model court {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  code      String
}

model Image {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  caseNumber      String
  cloudflareImgId String
  imgSrc          String   @default("")
}

model valuation {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  caseNumber String
  src        String   @default("")
}

model statementOfSale {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  caseNumber String
  itemNumber Int
  src        String   @default("")
}

model resultAuction {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  date         DateTime?
  type         String?
  location     String?
  minSalePrice String?
  result       String?
  item         Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId       Int

  @@index([itemId])
}

model realestateList {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  num       Int
  type      String
  usage     String   @default("")
  location  String   @default("")
  detail    String?  @db.MediumText
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    Int
}

model leaseDetail {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  content   String?  @db.MediumText
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    Int

  @@index([itemId])
}

model leasePeople {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  leaseName    String?
  leaseType    String?
  deposit      String?
  transferDate String?
  confirmDate  String?
  occupancy    String?  @default("")
  period       String?  @default("")
  rent         String?  @default("")
  item         Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId       Int

  @@index([itemId])
}

model Fav {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    Int
}

model adminComment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  category  String
  title     String
  comment   String   @db.MediumText
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    Int
}

generator client {
  provider             = "prisma-client-py"
  previewFeatures      = ["referentialIntegrity"]
  interface            = "asyncio"
  recursive_type_depth = "5"
}

datasource db {
  provider = "mysql"
  url      = "mysql://2deru4m0qi7e2pf0ymx8:pscale_pw_BU8Vd8IcnZKRfQh0ltEZs2dq9uIcZJQ71Jx3YJEfG1E@us-east.connect.psdb.cloud/auction-market-prod?sslaccept=strict"
}

model User {
  id        Int      @id @default(autoincrement())
  phone     String?  @unique
  email     String?  @unique
  name      String
  password  String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tokens    Token[]
  Fav       Fav[]
}

model Token {
  id        Int      @id @default(autoincrement())
  payload   String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Item {
  id                  Int             @id @default(autoincrement())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  caseNumber          String? //사건번호
  caseIndex           String? //사건고유번호
  itemNumber          String? //물건번호
  itemType            String? //물건종류
  initialPrice        String?
  minPrice            String?
  bidType             String?
  saleDate            DateTime?
  description         String?         @db.MediumText
  itemLocation        String?
  court               String?
  caseApplyDate       DateTime?
  auctionApplyDate    DateTime?
  allocationApplyDate DateTime?
  requestPrice        String?
  detailOfList        String?         @db.MediumText
  areaOfBuilding      Float?
  areaOfGround        Float?
  appraisal           String?         @db.MediumText
  status              Int?            @default(0)
  numOfPass           Int?            @default(0)
  share               Boolean?        @default(false)
  Image               Image[]
  resultAuction       resultAuction[]
  leaseDetail         leaseDetail[]
  leasePeople         leasePeople[]
  Fav                 Fav[]
}

model Image {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  item            Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId          Int
  cloudflareImgId String

  @@index([itemId])
}

model resultAuction {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  date         DateTime?
  type         String?
  location     String?
  minSalePrice String?
  result       String?
  item         Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId       Int

  @@index([itemId])
}

model leaseDetail {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  content   String?  @db.MediumText
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    Int

  @@index([itemId])
}

model leasePeople {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  leaseName    String?
  leaseType    String?
  deposit      String?
  transferDate String?
  confirmDate  String?
  item         Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId       Int

  @@index([itemId])
}

model Fav {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    Int
}

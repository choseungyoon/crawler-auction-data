model Item {
  id                  Int      @id @default(autoincrement())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  caseNumber          String
  itemNumber          String
  itemType            String
  initialPrice        String
  minPrice            String
  bidType             String
  saleDate            DateTime
  description         String   @db.MediumText
  itemLocation        String
  court               String
  caseApplyDate       DateTime
  auctionApplyDate    DateTime
  allocationApplyDate DateTime
  requestPrice        String
  detailOfList        String   @db.MediumText
  areaOfBuilding      Float
  areaOfGround        Float
  appraisal           String   @db.MediumText
  caseIndex           String
  numOfPass           Int      @default(0)
  share               Boolean  @default(false)
  status              Int      @default(0)
}

model Image {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  itemId          Int
  cloudflareImgId String

  @@index([itemId])
}

model resultAuction {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  date         DateTime?
  type         String?
  location     String?
  minSalePrice String?
  result       String?
  itemId       Int

  @@index([itemId])
}

model leaseDetail {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  content   String?
  itemId    Int

  @@index([itemId])
}

model leasePeople {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  leaseName    String?
  leaseType    String?
  deposit      String?
  transferDate String?
  confirmDate  String?
  itemId       Int

  @@index([itemId])
}

model Token {
  id        Int      @id @default(autoincrement())
  payload   String   @unique
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model User {
  id        Int      @id @default(autoincrement())
  phone     String?  @unique
  email     String?  @unique
  name      String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime
}

